---
import { getCollection } from "astro:content";
import { SOCIALS } from "@/config";
import { GAME_URL } from "@/data/profile";
import { getPath } from "@/utils/getPath";
import getSortedPosts from "@/utils/getSortedPosts";
import { noteDate, noteMinutes, noteNumbers } from "@/utils/notes";
import { smartQuotes } from "@/utils/smartQuotes";

type Kind = "nav" | "read" | "do";
interface Item {
  title: string;
  sub: string;
  kw: string;
  href?: string;
  action?: "theme" | "copy-email";
  external?: boolean;
  keys?: string;
}

const posts = getSortedPosts(await getCollection("blog"));
const numbers = noteNumbers(posts);
const email = SOCIALS.find((s) => s.icon === "mail")?.href.replace("mailto:", "") ?? "";
const social = (icon: string) => SOCIALS.find((s) => s.icon === icon)?.href ?? "";

const groups: { id: Kind; label: string; items: Item[] }[] = [
  {
    id: "nav",
    label: "Navigate",
    items: [
      { title: "Home", sub: "Back to base camp", kw: "home index start", href: "/" },
      { title: "Field notes", sub: "Every post, newest first", kw: "blog posts writing notes articles", href: "/posts" },
      { title: "About", sub: "Komatsu, Evernote, ISRO", kw: "about resume experience work cv", href: "/about" },
      { title: "Recess — play Desert Runner", sub: "Jump the saguaros, chase the world record", kw: "game play runner recess fun", href: "/game" },
      { title: "Search every note", sub: "Full-text search", kw: "search find", href: "/search" },
    ],
  },
  {
    id: "read",
    label: "Read",
    items: posts.map((p) => ({
      title: smartQuotes(p.data.title),
      sub: `No. ${numbers.get(p.id)} · ${noteDate(p)} · ${noteMinutes(p)}`,
      kw: `${p.data.tags.join(" ")} ${p.data.description}`,
      href: getPath(p.id, p.filePath),
    })),
  },
  {
    id: "do",
    label: "Do",
    items: [
      { title: "Switch day / night", sub: "Desert after sundown", kw: "dark night light day theme mode toggle", action: "theme" },
      { title: "Copy email address", sub: email, kw: "email contact mail hello hire", action: "copy-email" },
      { title: "Open GitHub", sub: social("github").replace("https://", ""), kw: "github code open source", href: social("github"), external: true },
      { title: "Open LinkedIn", sub: social("linkedin").replace("https://", ""), kw: "linkedin contact hire", href: social("linkedin"), external: true },
      { title: "Play in a new tab", sub: GAME_URL.replace("https://", ""), kw: "game play runner", href: GAME_URL, external: true },
      { title: "Subscribe via RSS", sub: "parthjpatel.me/rss.xml", kw: "rss subscribe feed follow", href: "/rss.xml" },
    ],
  },
];

const icons: Record<Kind | "search", string> = {
  nav: '<path d="M5 12h14M13 6l6 6-6 6"></path>',
  read: '<path d="M6 3h9l4 4v14H6z"></path><path d="M9 12h7M9 16h5"></path>',
  do: '<path d="M13 3L5 13h6l-1 8 8-10h-6z"></path>',
  search: '<circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path>',
};

const optionClass =
  "palette-option flex min-h-14 w-full items-center gap-3.5 rounded-xl px-3 py-2 text-left aria-selected:bg-accent-soft";
let n = 0;
---

<dialog
  id="palette"
  data-option-class={optionClass}
  transition:persist
  aria-label="Jump to anything"
  class="m-0 mx-auto mt-[8vh] w-[min(620px,calc(100vw-2rem))] max-w-none overflow-hidden rounded-[20px] bg-surface p-0 text-foreground shadow-[0_40px_80px_-24px_rgba(0,0,0,0.5)] backdrop:bg-[rgba(28,25,21,0.55)] backdrop:backdrop-blur-[2px]"
>
  <label class="flex h-16 items-center gap-3 border-b border-border pr-4 pl-5">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="shrink-0 text-subtle" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
    <span class="sr-only">Search notes, pages and actions</span>
    <input
      id="palette-input"
      type="text"
      role="combobox"
      aria-expanded="true"
      aria-controls="palette-list"
      aria-autocomplete="list"
      autocomplete="off"
      spellcheck="false"
      placeholder="Search notes, pages, actions…"
      class="h-11 grow bg-transparent text-lg outline-none placeholder:text-subtle"
    />
    <kbd class="rounded-md text-[11px] text-subtle">Esc</kbd>
  </label>

  <div id="palette-list" role="listbox" aria-label="Results" class="max-h-[min(420px,60vh)] overflow-y-auto overscroll-contain p-2">
    <div data-group="search" role="group" aria-labelledby="palette-g-search" hidden class="pb-1.5">
      <div id="palette-g-search" class="eyebrow px-3 pt-3 pb-1.5 text-[11px] text-subtle">In the notes</div>
      <div data-search-results></div>
    </div>
    {
      groups.map((g) => (
        <div data-group={g.id} role="group" aria-labelledby={`palette-g-${g.id}`} class="pb-1.5">
          <div id={`palette-g-${g.id}`} class="eyebrow px-3 pt-3 pb-1.5 text-[11px] text-subtle">
            {g.label}
          </div>
          {g.items.map((item) => {
            const inner = (
              <>
                <span class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-muted" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[g.id]} />
                </span>
                <span class="flex min-w-0 grow flex-col gap-0.5">
                  <span class="truncate text-[15px]">{item.title}</span>
                  <span class="truncate text-[13px] text-subtle">{item.sub}</span>
                </span>
                {item.external && <span class="font-mono text-xs text-subtle" aria-hidden="true">↗</span>}
                <span class="palette-enter hidden rounded-md bg-accent px-1.5 py-0.5 font-mono text-xs text-on-accent" aria-hidden="true">↵</span>
              </>
            );
            const common = {
              id: `palette-opt-${n++}`,
              role: "option",
              "aria-selected": "false",
              "data-item": "",
              "data-kw": `${item.title} ${item.sub} ${item.kw}`.toLowerCase(),
              class: optionClass,
              tabindex: "-1",
            };
            return item.href ? (
              <a href={item.href} {...common} {...(item.external && { target: "_blank", rel: "noopener noreferrer" })}>
                {inner}
              </a>
            ) : (
              <button type="button" data-action={item.action} data-email={item.action === "copy-email" ? email : undefined} {...common}>
                {inner}
              </button>
            );
          })}
        </div>
      ))
    }
    <div data-empty hidden class="flex flex-col items-center gap-2 px-6 py-14 text-center">
      <span class="font-display text-3xl">Nothing on the map for “<span data-empty-q></span>”.</span>
      <span class="text-[15px] text-subtle">Try “play”, “email” or “agents”.</span>
    </div>
  </div>

  <div class="flex h-11 items-center gap-5 border-t border-border bg-background px-5 font-mono text-[11px] tracking-[0.06em] text-subtle uppercase">
    <span class="max-sm:hidden">↑↓ Move</span>
    <span class="max-sm:hidden">↵ Open</span>
    <span class="grow">Esc close</span>
    <span data-toast aria-live="polite" class="text-accent"></span>
  </div>
  <template id="palette-search-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.search} /></template>
</dialog>

<script>
  type PagefindResult = { data: () => Promise<{ url: string; meta: { title?: string }; excerpt: string }> };
  type Pagefind = { search: (q: string) => Promise<{ results: PagefindResult[] }> };

  let pagefind: Pagefind | null | undefined;
  let searchTimer: ReturnType<typeof setTimeout> | undefined;
  let searchToken = 0;
  let toastTimer: ReturnType<typeof setTimeout> | undefined;

  const dialog = () => document.getElementById("palette") as HTMLDialogElement | null;
  const input = () => document.getElementById("palette-input") as HTMLInputElement | null;
  const visibleOptions = () =>
    Array.from(document.querySelectorAll<HTMLElement>("#palette-list [role=option]")).filter(
      (el) => !el.hidden && !el.closest("[data-group]")?.hasAttribute("hidden")
    );

  function isTyping(target: EventTarget | null) {
    return target instanceof HTMLElement && !!target.closest("input, textarea, select, [contenteditable=true]");
  }

  function select(el: HTMLElement | undefined) {
    const inp = input();
    document.querySelectorAll<HTMLElement>("#palette-list [role=option]").forEach((o) => {
      const on = o === el;
      o.setAttribute("aria-selected", String(on));
      o.querySelector(".palette-enter")?.classList.toggle("hidden", !on);
    });
    if (el) {
      inp?.setAttribute("aria-activedescendant", el.id);
      el.scrollIntoView({ block: "nearest" });
    } else {
      inp?.removeAttribute("aria-activedescendant");
    }
  }

  function current() {
    return visibleOptions().find((o) => o.getAttribute("aria-selected") === "true");
  }

  function move(step: number) {
    const opts = visibleOptions();
    if (!opts.length) return;
    const i = opts.indexOf(current() as HTMLElement);
    select(opts[(i + step + opts.length) % opts.length]);
  }

  function toast(text: string) {
    const el = document.querySelector("#palette [data-toast]");
    if (!el) return;
    el.textContent = text;
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => (el.textContent = ""), 1800);
  }

  function filter(raw: string) {
    const q = raw.trim().toLowerCase();
    document.querySelectorAll<HTMLElement>("#palette-list [data-group]").forEach((group) => {
      if (group.dataset.group === "search") return;
      let any = false;
      group.querySelectorAll<HTMLElement>("[data-item]").forEach((item) => {
        const hit = !q || q.split(/\s+/).every((word) => (item.dataset.kw ?? "").includes(word));
        item.hidden = !hit;
        any ||= hit;
      });
      group.hidden = !any;
    });
    updateEmpty(raw);
    select(visibleOptions()[0]);
    queueSearch(q);
  }

  function updateEmpty(raw: string) {
    const empty = document.querySelector<HTMLElement>("#palette [data-empty]");
    const q = document.querySelector("#palette [data-empty-q]");
    if (!empty || !q) return;
    q.textContent = raw.trim();
    empty.hidden = visibleOptions().length > 0;
  }

  async function loadPagefind(): Promise<Pagefind | null> {
    if (pagefind !== undefined) return pagefind;
    try {
      const path = "/pagefind/pagefind.js";
      pagefind = (await import(/* @vite-ignore */ path)) as Pagefind;
    } catch {
      pagefind = null; // Not built yet (dev mode) — static items still work
    }
    return pagefind;
  }

  function queueSearch(q: string) {
    clearTimeout(searchTimer);
    const token = ++searchToken;
    const group = document.querySelector<HTMLElement>('#palette [data-group="search"]');
    if (!group) return;
    if (q.length < 2) {
      group.hidden = true;
      return;
    }
    searchTimer = setTimeout(async () => {
      const pf = await loadPagefind();
      if (!pf || token !== searchToken) return;
      const { results } = await pf.search(q);
      const data = await Promise.all(results.slice(0, 5).map((r) => r.data()));
      if (token !== searchToken) return;
      renderSearch(group, data);
    }, 150);
  }

  function renderSearch(group: HTMLElement, data: Awaited<ReturnType<PagefindResult["data"]>>[]) {
    const list = group.querySelector("[data-search-results]");
    const icon = (document.getElementById("palette-search-icon") as HTMLTemplateElement | null)?.content;
    const cls = dialog()?.dataset.optionClass ?? "";
    if (!list) return;
    list.replaceChildren();
    data.forEach((d, i) => {
      const a = document.createElement("a");
      a.href = d.url.endsWith("/") ? d.url.slice(0, -1) : d.url;
      a.id = `palette-search-${i}`;
      a.className = cls;
      a.setAttribute("role", "option");
      a.setAttribute("aria-selected", "false");
      a.tabIndex = -1;

      const badge = document.createElement("span");
      badge.className = "flex size-8 shrink-0 items-center justify-center rounded-lg bg-muted";
      if (icon) badge.append(icon.cloneNode(true));
      const text = document.createElement("span");
      text.className = "flex min-w-0 grow flex-col gap-0.5";
      const title = document.createElement("span");
      title.className = "truncate text-[15px]";
      title.textContent = d.meta.title ?? a.href;
      const sub = document.createElement("span");
      sub.className = "truncate text-[13px] text-subtle";
      // Excerpts contain <mark> tags — keep only the text
      sub.textContent = new DOMParser().parseFromString(d.excerpt, "text/html").body.textContent ?? "";
      text.append(title, sub);
      const enter = document.createElement("span");
      enter.className = "palette-enter hidden rounded-md bg-accent px-1.5 py-0.5 font-mono text-xs text-on-accent";
      enter.setAttribute("aria-hidden", "true");
      enter.textContent = "↵";
      a.append(badge, text, enter);
      list.append(a);
    });
    group.hidden = data.length === 0;
    updateEmpty(input()?.value ?? "");
    if (!current()) select(visibleOptions()[0]);
  }

  function open() {
    const d = dialog();
    const inp = input();
    if (!d || !inp || d.open) return;
    d.showModal();
    inp.value = "";
    filter("");
    inp.focus();
    loadPagefind();
  }

  function close() {
    dialog()?.close();
  }

  async function activate(el: HTMLElement | undefined) {
    if (!el) return;
    const action = el.dataset.action;
    if (action === "theme") {
      close();
      document.getElementById("theme-btn")?.click();
    } else if (action === "copy-email") {
      try {
        await navigator.clipboard.writeText(el.dataset.email ?? "");
        toast("Email copied");
      } catch {
        window.location.href = `mailto:${el.dataset.email}`;
      }
    } else if (el instanceof HTMLAnchorElement) {
      close();
      el.click();
    }
  }

  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      if (dialog()?.open) close();
      else open();
    } else if (e.key === "/" && !isTyping(e.target) && !dialog()?.open) {
      e.preventDefault();
      open();
    }
  });

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.closest("[data-palette-open]")) {
      open();
      return;
    }
    const d = dialog();
    if (!d?.open) return;
    // Clicking the backdrop closes
    if (target === d) {
      close();
      return;
    }
    const option = target.closest<HTMLElement>("#palette-list [role=option]");
    if (option) {
      if (option instanceof HTMLAnchorElement) {
        close(); // let the link navigate normally
      } else {
        e.preventDefault();
        activate(option);
      }
    }
  });

  document.addEventListener("input", (e) => {
    if ((e.target as HTMLElement).id === "palette-input") filter((e.target as HTMLInputElement).value);
  });

  document.addEventListener("keydown", (e) => {
    if ((e.target as HTMLElement).id !== "palette-input") return;
    if (e.key === "ArrowDown") {
      e.preventDefault();
      move(1);
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      move(-1);
    } else if (e.key === "Enter") {
      e.preventDefault();
      activate(current());
    }
  });

  document.addEventListener("mousemove", (e) => {
    const option = (e.target as HTMLElement).closest?.<HTMLElement>("#palette-list [role=option]");
    if (option && option.getAttribute("aria-selected") !== "true") select(option);
  });
</script>
