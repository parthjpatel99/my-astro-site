---
export interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  /** Optional view-transition name for the title */
  titleTransition?: string;
}

const { eyebrow, title, description, titleTransition } = Astro.props;
---

<div class="flex flex-col gap-5 pt-14 pb-10 sm:pt-20 sm:pb-14">
  <span class="eyebrow text-accent">{eyebrow}</span>
  <h1
    class="font-display text-[clamp(3.25rem,8vw,6.5rem)] leading-[0.95] tracking-[-0.02em]"
    transition:name={titleTransition}
  >
    {title}
  </h1>
  {description && <p class="max-w-2xl text-lg leading-relaxed text-subtle sm:text-xl">{description}</p>}
  <slot />
</div>
