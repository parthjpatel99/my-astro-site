---
import { SITE } from "@/config";

const { pathname } = Astro.url;

// Remove trailing slash from current pathname if exists
const currentPath = pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  if (path.startsWith("/#")) return false;
  const currentPathArray = currentPath.split("/").filter((p) => p.trim());
  const pathArray = path.split("/").filter((p) => p.trim());
  return currentPath === path || (pathArray[0] !== undefined && currentPathArray[0] === pathArray[0]);
};

const links = [
  { href: "/#route", label: "Work" },
  { href: "/posts", label: "Field notes" },
  { href: "/game", label: "Recess" },
  { href: "/about", label: "About" },
];
---

<header class="sticky top-0 z-40 border-b border-border bg-background/85 backdrop-blur-md">
  <a
    id="skip-to-content"
    href="#main-content"
    class="absolute -top-full left-4 z-50 rounded-full bg-foreground px-4 py-2 text-background transition-all focus:top-3"
  >
    Skip to content
  </a>
  <div class="wrap flex h-16 items-center justify-between gap-4 sm:h-[72px]">
    <a href="/" class="flex items-center gap-3" aria-label={`${SITE.title} — home`}>
      <span
        class="flex size-9 items-center justify-center rounded-full border-[1.5px] border-foreground font-display text-[22px] leading-none"
        aria-hidden="true">P</span
      >
      <span class="hidden font-mono text-sm tracking-wide sm:inline">parthjpatel.me</span>
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex gap-8 text-[15px] lg:gap-10">
        {
          links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class:list={[
                  "transition-colors hover:text-accent",
                  { "text-accent": isActive(href) },
                ]}
                aria-current={isActive(href) ? "page" : undefined}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <button
        type="button"
        data-palette-open
        class="flex size-11 items-center justify-center gap-2.5 rounded-full border border-border bg-surface text-sm text-subtle transition-colors hover:border-foreground/40 lg:w-64 lg:justify-start lg:pr-2 lg:pl-4"
        aria-label="Jump to anything"
        aria-keyshortcuts="Meta+K Control+K"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
        <span class="hidden grow text-left lg:inline">Jump to anything</span>
        <kbd class="hidden lg:inline" data-mod-key>⌘K</kbd>
      </button>

      {
        SITE.lightAndDarkMode && (
          <button
            id="theme-btn"
            type="button"
            class="relative flex size-11 items-center justify-center rounded-full border border-border bg-surface transition-colors hover:border-foreground/40"
            title="Toggle day / night"
            aria-label="Switch to night mode"
          >
            <svg class="absolute scale-100 rotate-0 transition-all duration-300 dark:scale-0 dark:-rotate-90" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg>
            <svg class="absolute scale-0 rotate-90 transition-all duration-300 dark:scale-100 dark:rotate-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          </button>
        )
      }

      <button
        id="menu-btn"
        type="button"
        class="flex size-11 items-center justify-center rounded-full border border-border bg-surface md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="menu-items"
      >
        <svg id="menu-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h10"></path></svg>
        <svg id="close-icon" class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>
  </div>

  <nav id="menu-items" aria-label="Mobile" class="menu-collapsed border-border md:hidden">
    <ul class="wrap flex flex-col pb-4">
      {
        links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={[
                "flex items-center justify-between border-t border-border py-4 font-display text-3xl",
                { "text-accent": isActive(href) },
              ]}
            >
              {label}
              <span class="font-mono text-sm text-subtle" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    const setOpen = (open: boolean) => {
      menuBtn.setAttribute("aria-expanded", String(open));
      menuBtn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      menuItems.classList.toggle("menu-expanded", open);
      menuItems.classList.toggle("menu-collapsed", !open);
      menuIcon.classList.toggle("hidden", open);
      closeIcon.classList.toggle("hidden", !open);
    };

    menuBtn.addEventListener("click", () => {
      setOpen(menuBtn.getAttribute("aria-expanded") !== "true");
    });
    menuItems.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  }

  function showModKey() {
    const isMac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);
    document.querySelectorAll("[data-mod-key]").forEach((el) => {
      el.textContent = isMac ? "⌘K" : "Ctrl K";
    });
  }

  toggleNav();
  showModKey();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", () => {
    toggleNav();
    showModKey();
  });
</script>
