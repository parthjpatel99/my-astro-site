---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { getPath } from "@/utils/getPath";
import { noteDate, noteMinutes } from "@/utils/notes";
import { slugifyStr } from "@/utils/slugify";
import { smartQuotes } from "@/utils/smartQuotes";

export interface Props {
  post: CollectionEntry<"blog">;
  number?: string;
  /** Heavier top rule + "Featured" label */
  featured?: boolean;
  showImage?: boolean;
  headingLevel?: "h2" | "h3";
  animIndex?: number;
}

const { post, number, featured = false, showImage = true, headingLevel = "h3", animIndex } = Astro.props;
const { title, description, tags, heroImage } = post.data;
const href = getPath(post.id, post.filePath);
const Heading = headingLevel;
---

<li
  class:list={["group relative border-t", featured ? "border-foreground" : "border-border", animIndex !== undefined && "rise"]}
  style={animIndex !== undefined ? `animation-delay: ${animIndex * 70}ms` : undefined}
>
  <div class="grid gap-4 py-8 sm:py-10 md:grid-cols-[120px_minmax(0,1fr)_300px] md:gap-10 lg:grid-cols-[140px_minmax(0,1fr)_340px]">
    <span class="font-mono text-sm text-subtle">
      {number && <span class:list={[featured ? "text-accent" : "text-subtle"]}>No. {number}</span>}
      {featured && <span class="block max-md:ml-3 max-md:inline">Featured</span>}
      <span class="ml-3 md:hidden">{noteDate(post)} · {noteMinutes(post)}</span>
    </span>
    <div class="flex flex-col gap-3.5">
      <Heading class="font-display text-[clamp(2rem,4vw,3.25rem)] leading-[1.05] tracking-[-0.01em]">
        <a href={href} class="transition-colors after:absolute after:inset-0 group-hover:text-accent" style={{ viewTransitionName: slugifyStr(title) }}>
          {smartQuotes(title)}
        </a>
      </Heading>
      <p class="max-w-2xl text-lg leading-relaxed text-subtle">{smartQuotes(description)}</p>
      {
        tags.length > 0 && (
          <ul class="mt-1.5 flex flex-wrap gap-2" aria-label="Tags">
            {tags.slice(0, 3).map((tag) => (
              <li class="rounded-full border border-border px-3 py-1.5 font-mono text-xs">{tag}</li>
            ))}
          </ul>
        )
      }
    </div>
    <div class="hidden flex-col gap-4 md:flex md:items-end">
      <span class="hidden font-mono text-[13px] text-subtle md:inline">{noteDate(post)} · {noteMinutes(post)}</span>
      {
        showImage && heroImage && (
          <div class="duotone hidden aspect-[300/190] w-full overflow-hidden rounded-xl md:block">
            <Image
              src={heroImage}
              alt=""
              width={340}
              height={215}
              class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              format="webp"
              quality={75}
              loading="lazy"
              densities={[1, 2]}
            />
          </div>
        )
      }
    </div>
  </div>
</li>
