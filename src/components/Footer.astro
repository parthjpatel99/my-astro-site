---
import Hr from "./Hr.astro";
import Socials from "./Socials.astro";
import { SITE } from "@/config";

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer class:list={["w-full", { "mt-auto": !noMarginTop }]}>
  <Hr noPadding />
  <div
    class="mx-auto max-w-3xl px-4 flex flex-col items-center justify-between py-6 sm:flex-row sm:py-4"
  >
    <div class="my-2 flex flex-col items-center sm:flex-row text-sm sm:text-base">
      <span>
        &copy; {new Date().getFullYear()} {SITE.author} ·
        <a href="https://github.com/parthjpatel99/my-astro-site" target="_blank" rel="noopener noreferrer" class="hover:text-accent">Code: MIT</a>
      </span>
    </div>
    <div class="flex-shrink-0">
      <Socials centered />
    </div>
  </div>
</footer>
