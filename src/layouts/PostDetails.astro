---
import { type CollectionEntry, render } from "astro:content";
import { Image } from "astro:assets";
import avatarImage from "@/assets/images/parth-avatar.jpg";
import IconBlueSky from "@/assets/icons/IconBlueSky.svg";
import IconBrandX from "@/assets/icons/IconBrandX.svg";
import IconLinkedin from "@/assets/icons/IconLinkedin.svg";
import StructuredData from "@/components/StructuredData.astro";
import { SHARE_LINKS } from "@/constants";
import { SITE } from "@/config";
import Layout from "@/layouts/Layout.astro";
import { getPath } from "@/utils/getPath";
import { noteDate, noteMinutes, noteNumbers } from "@/utils/notes";
import { calculateReadingTime } from "@/utils/readingTime";
import { slugifyStr } from "@/utils/slugify";
import { smartQuotes } from "@/utils/smartQuotes";
import { elevationProfile } from "@/utils/topo";

export interface Props {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
}

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
  hideEditPost,
  heroImage,
  tldr,
} = post.data;

const { Content, headings } = await render(post);
const readingTime = calculateReadingTime(post.body ?? "");
const minutes = parseInt(readingTime, 10) || 1;

let ogImageUrl: string | undefined;

// Determine OG image source
if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage; // Remote OG image (absolute URL)
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src; // Local asset
}

// Use dynamic OG image if enabled and no remote|local ogImage
if (!ogImageUrl && SITE.dynamicOgImage) {
  ogImageUrl = `${getPath(post.id, post.filePath)}/index.png`;
}

// Resolve OG image URL (or fallback to SITE.ogImage / default `og.png`)
const ogImage = ogImageUrl ? new URL(ogImageUrl, Astro.url.origin).href : undefined;

// Generate the canonical URL - always use the full path with year
const postPath = getPath(post.id, post.filePath, true);
const computedCanonicalURL =
  canonicalURL ||
  (Astro.site ? new URL(postPath, Astro.site).href : new URL(postPath, Astro.url.origin).href);

const layoutProps = {
  title: `${title} · ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL: computedCanonicalURL,
  ogImage,
  scrollSmooth: true,
};

/* ========== Field-note numbering + neighbours ========== */
const numbers = noteNumbers(posts);
// Unlisted/draft posts aren't numbered
const number = numbers.get(post.id);
const index = posts.findIndex((p) => p.id === post.id);
// `posts` is newest first
const newer = index > 0 ? posts[index - 1] : null;
const older = index >= 0 && index < posts.length - 1 ? posts[index + 1] : null;

const toc = headings.filter((h) => h.depth === 2 && h.slug !== "table-of-contents");
const summit = toc.at(-1)?.text;
const wordCount = (post.body ?? "").split(/\s+/).filter(Boolean).length;
const editHref = `${SITE.editPost.url}${post.filePath}`;
const showEdit = SITE.editPost.enabled && !hideEditPost;

const shareURL = new URL(Astro.url.pathname, SITE.website).href;
const shareIcons = { twitter: IconBrandX, bluesky: IconBlueSky, linkedin: IconLinkedin };
const shares = SHARE_LINKS.filter((s) => s.icon in shareIcons);
const profile = elevationProfile(post.id);
---

<Layout {...layoutProps}>
  <StructuredData
    type="BlogPosting"
    data={{
      title,
      description,
      author,
      pubDatetime,
      modDatetime,
      url: Astro.url.href,
      ogImage,
      tags,
      wordCount,
      readingTime,
    }}
  />

  <!-- Reading progress as an elevation profile -->
  <div
    id="elevation"
    data-minutes={minutes}
    class="sticky top-16 z-30 h-10 overflow-hidden border-b border-border bg-muted sm:top-[72px] sm:h-12"
    style="--p: 0"
    aria-hidden="true"
    data-pagefind-ignore
  >
    <svg viewBox="0 0 1440 48" preserveAspectRatio="none" class="absolute inset-0 size-full">
      <path d={profile} fill="var(--border)"></path>
    </svg>
    <svg viewBox="0 0 1440 48" preserveAspectRatio="none" class="elevation-climbed absolute inset-0 size-full">
      <path d={profile} fill="var(--accent)" opacity="0.85"></path>
    </svg>
    <div class="elevation-marker absolute inset-y-0 w-px bg-foreground"></div>
    <span data-elev-label class="elevation-label absolute top-1.5 bg-muted px-1.5 py-0.5 font-mono text-[10px] tracking-[0.1em] whitespace-nowrap sm:text-[11px]">
      0% CLIMBED · ~{minutes} MIN LEFT
    </span>
    {
      summit && (
        <span data-elev-summit class="absolute top-1/2 right-5 hidden -translate-y-1/2 font-mono text-[11px] tracking-[0.1em] text-subtle uppercase transition-opacity lg:right-20 lg:block">
          Summit · {summit}
        </span>
      )
    }
  </div>

  <main id="main-content" class="wrap pt-12 sm:pt-20" data-pagefind-body>
    <div class="grid gap-y-10 lg:grid-cols-[180px_minmax(0,680px)_minmax(0,1fr)] lg:gap-x-12 lg:gap-y-14 xl:grid-cols-[220px_680px_260px] xl:gap-x-[60px]">
      <div class="hidden flex-col gap-2 lg:flex" data-pagefind-ignore>
        <span class="eyebrow text-xs text-subtle">Field note</span>
        {number && <span class="font-display text-[140px] leading-[0.8] text-accent">{number}</span>}
      </div>

      <header class="flex flex-col gap-6 lg:col-span-2">
        <nav aria-label="Breadcrumb" class="flex flex-wrap gap-2.5 font-mono text-[13px] tracking-[0.06em] text-subtle" data-pagefind-ignore>
          <a href="/" class="hover:text-accent">Home</a><span aria-hidden="true">/</span>
          <a href="/posts" class="hover:text-accent">Field notes</a><span aria-hidden="true">/</span>
          <span class="text-foreground" aria-current="page">{number ? `No. ${number}` : "Unlisted"}</span>
        </nav>
        <h1
          transition:name={slugifyStr(title)}
          class="font-display text-[clamp(3rem,7vw,6rem)] leading-[0.98] tracking-[-0.02em] text-balance"
        >
          {smartQuotes(title)}
        </h1>
        <p class="max-w-[820px] font-display text-[clamp(1.375rem,2.4vw,1.875rem)] leading-[1.3] text-foreground/80 italic">
          {smartQuotes(description)}
        </p>
        <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-4">
          <div class="flex items-center gap-4">
          <Image src={avatarImage} alt="" width={44} height={44} densities={[1, 2]} format="webp" loading="eager" class="size-11 shrink-0 rounded-full object-cover" />
          <div class="flex flex-col gap-0.5">
            <span class="text-[15px] font-medium">{author}</span>
            <span class="font-mono text-xs tracking-[0.06em] text-subtle">
              <time datetime={pubDatetime.toISOString()}>{noteDate(post)}</time>
              {modDatetime && modDatetime > pubDatetime && <> · UPDATED</>} · {noteMinutes(post)} READ · {wordCount.toLocaleString("en-US")} WORDS
            </span>
          </div>
          </div>
          <ul class="flex flex-wrap gap-2 sm:ml-auto" aria-label="Tags">
            {
              tags.map((tag) => (
                <li>
                  <a href={`/tags/${slugifyStr(tag)}`} class="block rounded-full border border-border px-3 py-1.5 font-mono text-xs transition-colors hover:border-accent hover:text-accent">
                    {tag}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </header>

      {
        heroImage && (
          <figure class="lg:col-span-2 lg:col-start-2">
            <div class="duotone aspect-[16/9] overflow-hidden rounded-[20px] sm:aspect-[1000/460]">
              <img src={heroImage} alt="" class="size-full object-cover" fetchpriority="high" />
            </div>
          </figure>
        )
      }

      <aside class="hidden lg:block" data-pagefind-ignore>
        <div class="sticky top-[150px] flex flex-col gap-5">
          {
            toc.length > 0 && (
              <>
                <span class="eyebrow text-xs text-subtle">On this note</span>
                <ol class="flex flex-col gap-3.5 text-[15px] leading-snug" id="toc">
                  {toc.map((h, i) => (
                    <li>
                      <a href={`#${h.slug}`} data-toc={h.slug} class="toc-link flex gap-3 text-subtle transition-colors hover:text-foreground">
                        <span class="pt-0.5 font-mono text-xs">{String(i + 1).padStart(2, "0")}</span>
                        <span>{h.text}</span>
                      </a>
                    </li>
                  ))}
                </ol>
                <div class="h-px bg-border" />
              </>
            )
          }
          {
            showEdit && (
              <a href={editHref} target="_blank" rel="noopener noreferrer" class="text-sm text-subtle underline-offset-4 hover:text-accent hover:underline">
                {SITE.editPost.text} ↗
              </a>
            )
          }
        </div>
      </aside>

      <div class="min-w-0">
        <article id="article" class="prose">
          <Content />
        </article>

        <div class="mt-16 flex flex-wrap items-center gap-3 border-t border-border pt-7" data-pagefind-ignore>
          <span class="eyebrow grow text-xs text-subtle">Share this note</span>
          {
            shares.map((s) => {
              const Icon = shareIcons[s.icon as keyof typeof shareIcons];
              return (
                <a
                  href={`${s.href}${shareURL}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  title={s.linkTitle}
                  class="flex size-11 items-center justify-center rounded-full border border-border bg-surface transition-colors hover:border-accent hover:text-accent"
                >
                  <Icon class="size-[18px] fill-transparent stroke-current stroke-2" aria-hidden="true" />
                  <span class="sr-only">{s.linkTitle}</span>
                </a>
              );
            })
          }
          <button
            type="button"
            id="copy-link"
            data-url={shareURL}
            class="flex h-11 items-center gap-2 rounded-full bg-foreground px-[18px] text-sm text-background transition-transform hover:-translate-y-0.5"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"></path></svg>
            <span data-copy-label>Copy link</span>
          </button>
        </div>

        <nav
          aria-label="More field notes"
          class="mt-10 grid gap-4 sm:grid-cols-2"
          data-pagefind-ignore
          data-prev-url={newer ? getPath(newer.id, newer.filePath) : ""}
          data-next-url={older ? getPath(older.id, older.filePath) : ""}
        >
          {
            [
              { p: older, label: "Older note", align: "" },
              { p: newer, label: "Newer note", align: "sm:col-start-2 sm:text-right" },
            ].map(
              ({ p, label, align }) =>
                p && (
                  <a
                    href={getPath(p.id, p.filePath)}
                    class:list={["group flex flex-col gap-2.5 rounded-[20px] border border-border bg-surface p-6 transition-colors hover:border-accent", align]}
                  >
                    <span class="eyebrow text-xs text-accent">
                      {label} · No. {numbers.get(p.id)}
                    </span>
                    <span class="font-display text-[28px] leading-[1.1] group-hover:text-accent">{smartQuotes(p.data.title)}</span>
                    <span class="text-[15px] text-subtle">{calculateReadingTime(p.body ?? "")}</span>
                  </a>
                )
            )
          }
        </nav>
      </div>

      <aside class="hidden lg:block" data-pagefind-ignore>
        <div class="sticky top-[150px] flex flex-col gap-7">
          {
            tldr && (
              <div data-theme="dark" class="flex flex-col gap-2.5 rounded-2xl bg-background p-5 text-foreground">
                <span class="font-mono text-[11px] tracking-[0.12em] text-accent">THE SHORT VERSION</span>
                <span class="font-display text-2xl leading-[1.2]">{tldr}</span>
              </div>
            )
          }
          <div class="flex flex-col gap-2 text-sm text-subtle">
            <span class="font-mono text-xs tracking-[0.1em]">KEYBOARD</span>
            <span><kbd>J</kbd> / <kbd>K</kbd> older / newer note</span>
            <span><kbd data-mod-key>⌘K</kbd> jump anywhere</span>
          </div>
        </div>
      </aside>
    </div>
  </main>
</Layout>

<style>
  #elevation .elevation-climbed {
    clip-path: inset(0 calc(100% - var(--p) * 1%) 0 0);
  }
  #elevation .elevation-marker {
    left: calc(var(--p) * 1%);
  }
  #elevation .elevation-label {
    left: min(calc(var(--p) * 1% + 12px), calc(100% - 15rem));
  }
  .toc-link[aria-current="true"] {
    color: var(--accent);
    font-weight: 500;
  }
</style>

<script is:inline data-astro-rerun>
  /** Reading progress drawn as an elevation profile */
  function setupElevation() {
    const bar = document.getElementById("elevation");
    const article = document.getElementById("article");
    if (!bar || !article) return;
    const label = bar.querySelector("[data-elev-label]");
    const summit = bar.querySelector("[data-elev-summit]");
    const total = Number(bar.dataset.minutes) || 1;
    let ticking = false;

    const update = () => {
      ticking = false;
      const rect = article.getBoundingClientRect();
      const travelled = window.innerHeight * 0.5 - rect.top;
      const p = Math.max(0, Math.min(1, travelled / rect.height));
      const pct = Math.round(p * 100);
      bar.style.setProperty("--p", String(pct));
      if (label) {
        label.textContent =
          pct >= 100 ? "SUMMIT REACHED" : `${pct}% CLIMBED · ~${Math.max(1, Math.ceil(total * (1 - p)))} MIN LEFT`;
      }
      if (summit) summit.style.opacity = pct > 55 ? "0" : "1";
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    document.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    document.addEventListener("astro:before-swap", () => document.removeEventListener("scroll", onScroll), { once: true });
    update();
  }
  setupElevation();

  /** Highlight the section being read in the table of contents */
  function setupTocSpy() {
    const links = Array.from(document.querySelectorAll("[data-toc]"));
    if (!links.length) return;
    const headings = links.map((l) => document.getElementById(l.dataset.toc)).filter(Boolean);
    let ticking = false;
    const update = () => {
      ticking = false;
      const line = window.innerHeight * 0.35;
      let active = "";
      for (const h of headings) {
        if (h.getBoundingClientRect().top <= line) active = h.id;
      }
      links.forEach((l) => l.setAttribute("aria-current", String(l.dataset.toc === active)));
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    document.addEventListener("scroll", onScroll, { passive: true });
    document.addEventListener("astro:before-swap", () => document.removeEventListener("scroll", onScroll), { once: true });
    update();
  }
  setupTocSpy();

  /** Attaches links to headings in the document, allowing sharing of sections easily */
  function addHeadingLinks() {
    const headings = Array.from(document.querySelectorAll("#article h2, #article h3, #article h4"));
    for (const heading of headings) {
      heading.classList.add("group");
      const link = document.createElement("a");
      link.className = "heading-link ml-1 font-mono text-base text-subtle no-underline opacity-0 group-hover:opacity-100 focus:opacity-100";
      link.href = "#" + heading.id;
      link.setAttribute("aria-label", "Link to this section");
      link.textContent = "#";
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  /** Attaches copy buttons to code blocks in the document */
  function attachCopyButtons() {
    const copyButtonLabel = "Copy";
    const codeBlocks = Array.from(document.querySelectorAll("pre"));

    for (const codeBlock of codeBlocks) {
      const wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      const copyButton = document.createElement("button");
      copyButton.className =
        "copy-code absolute right-3 -top-3 rounded-full border border-border bg-surface px-3 py-1 font-mono text-xs leading-4 text-foreground";
      copyButton.textContent = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);

      copyButton.addEventListener("click", async () => {
        const text = codeBlock.querySelector("code")?.innerText;
        await navigator.clipboard.writeText(text ?? "");
        copyButton.textContent = "Copied";
        setTimeout(() => (copyButton.textContent = copyButtonLabel), 700);
      });
    }
  }
  attachCopyButtons();

  /** Copy the post URL */
  function setupCopyLink() {
    const btn = document.getElementById("copy-link");
    const label = btn?.querySelector("[data-copy-label]");
    btn?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.url || location.href);
        if (label) label.textContent = "Copied";
      } catch {
        if (label) label.textContent = "Copy failed";
      }
      setTimeout(() => label && (label.textContent = "Copy link"), 1400);
    });
  }
  setupCopyLink();

  /* Go to page start after page swap */
  document.addEventListener("astro:after-swap", () => window.scrollTo({ left: 0, top: 0, behavior: "instant" }));

  /** Add lazy loading to all images in the article */
  function addLazyLoading() {
    const article = document.querySelector("#article");
    if (!article) return;
    article.querySelectorAll("img:not([loading])").forEach((img) => img.setAttribute("loading", "lazy"));
  }
  addLazyLoading();

  /** Keyboard navigation for posts: J = older, K = newer */
  function setupKeyboardNavigation() {
    const navContainer = document.querySelector("[data-prev-url]");
    if (!navContainer) return;

    const prevUrl = navContainer.getAttribute("data-prev-url");
    const nextUrl = navContainer.getAttribute("data-next-url");

    const onKey = (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      if (e.target.closest && e.target.closest('input, textarea, [contenteditable="true"], dialog')) return;
      if (e.key === "j" && nextUrl) window.location.href = nextUrl;
      else if (e.key === "k" && prevUrl) window.location.href = prevUrl;
    };
    document.addEventListener("keydown", onKey);
    document.addEventListener("astro:before-swap", () => document.removeEventListener("keydown", onKey), { once: true });
  }
  setupKeyboardNavigation();

  /** Process YouTube embeds written as {% youtube <id|url> %} */
  function processEmbeds() {
    const article = document.querySelector("#article");
    if (!article) return;

    const extractYouTubeId = (input) => {
      let videoId = input;
      try {
        if (videoId.includes("youtube.com/watch")) {
          videoId = new URL(videoId).searchParams.get("v") || "";
        } else if (videoId.includes("youtu.be/")) {
          videoId = videoId.split("youtu.be/")[1]?.split("?")[0] || "";
        } else if (videoId.includes("youtube.com/embed/")) {
          videoId = videoId.split("youtube.com/embed/")[1]?.split("?")[0] || "";
        }
      } catch (_) {
        // If URL parsing fails, fall back to the raw input
      }
      return videoId.replace(/[^a-zA-Z0-9_-]/g, "");
    };

    article.querySelectorAll("p").forEach((p) => {
      const text = (p.textContent || "").trim();
      const ytMatch = text.match(/^\{% youtube (https:\/\/[^\s]+|[a-zA-Z0-9_-]+) %\}$/);
      if (!ytMatch || !ytMatch[1]) return;
      const container = document.createElement("div");
      container.className = "youtube-embed-container";
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube.com/embed/${extractYouTubeId(ytMatch[1])}`;
      iframe.title = "YouTube video player";
      iframe.loading = "lazy";
      iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
      iframe.allowFullscreen = true;
      container.appendChild(iframe);
      p.replaceWith(container);
    });
  }
  processEmbeds();
</script>

<style is:global>
  .youtube-embed-container {
    margin: 2rem 0;
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* 16:9 aspect ratio */
    height: 0;
    overflow: hidden;
    border-radius: 1rem;
  }

  .youtube-embed-container iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
