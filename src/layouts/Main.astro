---
import PageHeader from "@/components/PageHeader.astro";
import { SITE } from "@/config";

interface StringTitleProp {
  pageTitle: string;
  pageDesc?: string;
  eyebrow?: string;
}

interface ArrayTitleProp {
  pageTitle: [string, string];
  titleTransition: string;
  pageDesc?: string;
  eyebrow?: string;
}

export type Props = StringTitleProp | ArrayTitleProp;

const { props } = Astro;

const backUrl = SITE.showBackButton ? Astro.url.pathname : "/";
const title = Array.isArray(props.pageTitle) ? props.pageTitle.join(" ") : props.pageTitle;
---

<main data-backUrl={backUrl} id="main-content" class="wrap pb-4">
  <PageHeader
    eyebrow={props.eyebrow ?? "parthjpatel.me"}
    title={title}
    description={props.pageDesc}
    titleTransition={"titleTransition" in props ? props.titleTransition : undefined}
  />
  <slot />
</main>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null = document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
