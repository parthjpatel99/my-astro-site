---
import { getCollection } from "astro:content";
import NoteRow from "@/components/NoteRow.astro";
import PageHeader from "@/components/PageHeader.astro";
import { SITE } from "@/config";
import Layout from "@/layouts/Layout.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { noteNumbers } from "@/utils/notes";

const posts = getSortedPosts(await getCollection("blog"));
const numbers = noteNumbers(posts);

const title = `Field notes | ${SITE.title}`;
const description = "Notes on backend systems, AI tooling and building software in the age of agents — written from Tucson, AZ.";
---

<Layout title={title} description={description}>
  <main id="main-content" class="wrap">
    <PageHeader
      eyebrow={`Field notes · ${posts.length} ${posts.length === 1 ? "entry" : "entries"}`}
      title="Written from the Painted Hills."
      description={description}
    >
      <div class="flex gap-7 pt-2">
        <a href="/rss.xml" class="underline decoration-accent underline-offset-[5px] hover:text-accent">Subscribe via RSS</a>
        <a href="/tags" class="underline decoration-accent underline-offset-[5px] hover:text-accent">Browse by tag</a>
      </div>
    </PageHeader>
    <ul class="border-b border-border">
      {posts.map((post, i) => <NoteRow post={post} number={numbers.get(post.id)} headingLevel="h2" animIndex={i} />)}
    </ul>
  </main>
</Layout>
