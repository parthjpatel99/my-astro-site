---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { SITE } from "../../config";

const posts = await getCollection("blog", ({ data }) => !data.draft);

const sortedPosts = posts.sort(
  (a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf()
);

const title = `Blog | ${SITE.title}`;
const description = "Technical articles and updates.";
---

<Layout title={title} description={description}>
  <section class="max-w-3xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-8">Blog</h1>
    
    <div class="flex flex-col gap-8">
      {sortedPosts.map((post) => (
        <article class="prose dark:prose-invert">
          <a href={`/posts/${post.id}`} class="no-underline group">
            <h2 class="text-2xl font-bold mb-2 group-hover:text-accent transition-colors">
              {post.data.title}
            </h2>
          </a>
          <div class="text-sm text-muted-foreground mb-4">
            {post.data.pubDatetime.toLocaleDateString("en-US", {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}
          </div>
          <p>{post.data.description}</p>
        </article>
      ))}
    </div>
  </section>
</Layout>
