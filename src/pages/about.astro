---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../config";

const title = `About ${SITE.author}`;
const description = "Software Engineer based in Tucson, AZ specializing in Kotlin, Java, Python, and Cloud Technologies.";
---

<Layout title={title} description={description}>
  <section class="max-w-3xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-8">About</h1>
    
    <div class="flex flex-col md:flex-row gap-8 items-start">
      <!-- Image Section -->
      <div class="w-full md:w-1/3 flex-shrink-0">
        <img 
          src="/about-portrait.jpg" 
          alt={SITE.author} 
          class="w-full rounded-2xl shadow-lg hover:shadow-xl transition-shadow duration-300 transform hover:scale-[1.02]"
        />
      </div>

      <!-- Content Section -->
      <div class="flex-1 prose dark:prose-invert max-w-none">
        <p class="lead text-lg mb-6">
          I am a Software Engineer transitioning from writing code to orchestrating intelligent systems.
        </p>
        
        <p class="mb-6">
          Currently, I safeguard mission-critical mining fleets at <strong>Komatsu</strong>, engineering sub-second Kotlin microservices that support $100k+/hour operations.
        </p>

        <p class="mb-6">
          My foundation is built on shipping native iOS apps and scaling features to 200M+ users at <strong>Evernote</strong>, but my focus has shifted to <strong>Azure architecture</strong> and <strong>Agentic AI workflows</strong>.
        </p>

        <p class="mb-6">
          I build software with the same ethos as the Tucson landscape I live in: robust, efficient, and stripped of unnecessary fluff.
        </p>
        
        <p class="mb-8">
          When I'm not optimizing CI/CD pipelines or exploring <strong>Google Antigravity</strong>, you can find me on the trails near Starr Pass.
        </p>

        <a href="#experience" class="no-underline border-b-2 border-dashed border-accent hover:border-solid transition-all">
          Check out my experience & skills below.
        </a>
      </div>
    </div>

    <!-- GitHub Activity Section -->
    <div class="mt-16">
      <h2 class="text-2xl font-bold mb-6 font-mono">GitHub Activity</h2>
      <div class="p-4 border border-skin-line rounded-lg bg-skin-card opacity-80 hover:opacity-100 transition-opacity">
        <img 
          src={`https://ghchart.rshah.org/${SITE.author.split(' ')[0]}jpatel99`} 
          alt="GitHub Contribution Chart" 
          class="w-full dark:invert"
        />
      </div>
      <p class="mt-4 italic text-muted-foreground">
        I build what excites me and release it all as open source.
      </p>
    </div>
    
    <hr class="my-12 border-skin-line" />

    <!-- Experience Section (Keeping the data provided before but restyled) -->
    <h2 id="experience" class="text-2xl font-bold mb-6 font-mono">Experience</h2>

    <div class="space-y-12">
      <div>
        <div class="flex flex-col sm:flex-row justify-between items-baseline mb-2">
          <h3 class="text-xl font-bold text-accent">Komatsu</h3>
          <span class="text-sm text-muted-foreground font-mono">Feb 2023 – Present</span>
        </div>
        <p class="mb-4 italic opacity-80">Software Engineer | Tucson, AZ</p>
        <ul class="list-disc pl-5 space-y-2 opacity-90">
          <li>Safeguarded mission-critical mining operations valued at $100k+/hour by engineering a low-latency <strong>Kotlin microservice</strong>.</li>
          <li>Achieved sub-second UI latency for the Fleet Management System by architecting a non-blocking asynchronous communication pattern.</li>
          <li>Slashed developer onboarding time by 75% by establishing a robust <strong>Azure CI/CD pipeline</strong>.</li>
          <li>Accelerated deployment velocity by 60% with a zero-error Docker-based release pipeline.</li>
        </ul>
      </div>

       <div>
        <div class="flex flex-col sm:flex-row justify-between items-baseline mb-2">
          <h3 class="text-xl font-bold text-accent">Evernote</h3>
          <span class="text-sm text-muted-foreground font-mono">Jun 2022 – Aug 2022</span>
        </div>
        <p class="mb-4 italic opacity-80">Software Engineer Intern | Remote, NY</p>
        <ul class="list-disc pl-5 space-y-2 opacity-90">
          <li>Shipped the "Repeat After Completion" feature to 50,000+ beta users using <strong>TypeScript/GraphQL</strong>.</li>
          <li>Deployed a reusable task-filtering component to 200M+ users.</li>
        </ul>
      </div>
    </div>

    <div class="mt-16 p-8 bg-skin-card rounded-2xl border border-skin-line text-center">
      <h2 class="text-2xl font-bold mb-4">Stay Connected</h2>
      <p class="mb-6">Follow me on GitHub and catch the back-story in my contributions.</p>
      <div class="flex justify-center gap-4">
         <a href="https://github.com/parthjpatel99" target="_blank" rel="noopener noreferrer" class="px-6 py-3 bg-skin-fill text-skin-base font-bold rounded-lg border border-skin-line hover:bg-skin-card-muted transition-colors">
           GitHub
         </a>
         <a href="https://linkedin.com/in/parthjpatel99" target="_blank" rel="noopener noreferrer" class="px-6 py-3 bg-[#0077b5] text-white font-bold rounded-lg hover:opacity-90 transition-opacity">
           LinkedIn
         </a>
      </div>
    </div>

  </section>
</Layout>
