---
import { Image } from "astro:assets";
import aboutPortrait from "@/assets/images/about-portrait.jpg";
import PageHeader from "@/components/PageHeader.astro";
import StructuredData from "@/components/StructuredData.astro";
import { SITE } from "@/config";
import { LOCATION, ROUTE, SUMMARY } from "@/data/profile";
import Layout from "@/layouts/Layout.astro";

const title = `About · ${SITE.title}`;
const description = SUMMARY;
// Newest first on this page
const stops = [...ROUTE].reverse();
---

<Layout title={title} description={description}>
  <StructuredData type="Person" data={{}} />
  <main id="main-content" class="wrap">
    <PageHeader eyebrow={`About · ${LOCATION.city}`} title="Hi, I’m Parth." />

    <div class="grid gap-10 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-16">
      <figure class="relative">
        <Image
          src={aboutPortrait}
          alt={SITE.author}
          width={640}
          height={720}
          format="webp"
          quality={82}
          class="aspect-[8/9] w-full rounded-[20px] object-cover"
        />
        <figcaption class="mt-3 font-mono text-xs tracking-[0.06em] text-subtle">
          {LOCATION.coords.toUpperCase()} · <span data-clock>--:--</span> {LOCATION.timezoneLabel}
        </figcaption>
      </figure>
      <div class="flex flex-col gap-6 text-lg leading-relaxed sm:text-xl">
        <p class="font-display text-[clamp(1.75rem,3vw,2.5rem)] leading-[1.2]">
          I own the real-time data platform behind Komatsu’s autonomous haulage system — distributed Kotlin/Spring Boot services and
          AI-augmented developer tooling, including a custom <em class="text-accent">MCP server</em> that lets coding agents work with our APIs.
        </p>
        <p>
          I’m a Software Engineer II in Tucson and the go-to technical liaison for the partner teams that build on the platform. Before that I
          shipped features to <strong>200M+ users</strong> at Evernote and built deep learning pipelines at ISRO.
        </p>
        <p>
          Always open to conversations about backend systems, AI tooling, or hard infrastructure problems —
          <a href="mailto:parth8199@gmail.com" class="text-accent underline decoration-1 underline-offset-[5px]">feel free to reach out</a>.
        </p>
        <div class="mt-2 flex flex-wrap gap-3">
          <a href="#experience" class="flex h-[52px] items-center rounded-full bg-foreground px-[26px] text-base font-medium text-background transition-transform hover:-translate-y-0.5">
            See the route
          </a>
          <a href="/posts" class="flex h-[52px] items-center rounded-full border border-foreground px-[26px] text-base font-medium transition-colors hover:bg-foreground hover:text-background">
            Read the field notes
          </a>
        </div>
      </div>
    </div>

    <section id="experience" class="scroll-mt-24 pt-24 sm:pt-32">
      <div class="flex flex-col gap-[18px]">
        <span class="eyebrow text-accent">The route so far</span>
        <h2 class="font-display text-[clamp(3rem,6vw,4.75rem)] leading-none tracking-[-0.015em]">From ocean eddies<br />to open-pit mines.</h2>
      </div>
      <ol class="relative mt-14 flex flex-col">
        {
          stops.map((stop, i) => (
            <li class="relative grid gap-4 border-t border-border py-10 pl-10 md:grid-cols-[260px_minmax(0,1fr)_200px] md:gap-10 md:pl-12">
              {i < stops.length - 1 && (
                <span class="absolute top-[3.1rem] bottom-[-3.1rem] left-[7px] border-l-2 border-dashed border-contour-strong" aria-hidden="true" />
              )}
              <span class="absolute top-11 left-0 flex size-4 items-center justify-center" aria-hidden="true">
                {stop.current && <span class="absolute size-4 animate-ping rounded-full bg-accent opacity-60 motion-reduce:animate-none" />}
                <span class:list={["relative size-4 rounded-full border-2", stop.current ? "border-accent bg-accent" : "border-foreground bg-background"]} />
              </span>
              <div class="flex flex-col gap-2">
                <span class:list={["font-mono text-xs tracking-[0.1em] uppercase", stop.current ? "text-accent" : "text-subtle"]}>
                  {stop.dates}
                </span>
                <h3 class="font-display text-[34px] leading-[1.1]">{stop.company}</h3>
                <span class="text-[15px] text-subtle">
                  {stop.role} · {stop.place}
                </span>
              </div>
              <ul class="flex list-disc flex-col gap-2.5 pl-5 leading-relaxed marker:text-accent [&_strong]:font-semibold">
                {stop.bullets.map((b) => (
                  <li set:html={b} />
                ))}
              </ul>
              <div class="flex flex-col gap-1 md:items-end md:text-right">
                <span class="font-display text-6xl leading-none text-accent">{stop.stat}</span>
                <span class="text-sm leading-snug text-subtle">{stop.statCaption}</span>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="pt-16 sm:pt-24">
      <div class="flex flex-col gap-[18px]">
        <span class="eyebrow text-accent">Commit log</span>
        <h2 class="font-display text-[clamp(2.5rem,5vw,3.75rem)] leading-none tracking-[-0.015em]">I build what excites me.</h2>
        <p class="max-w-2xl text-lg text-subtle">…and release it all as open source.</p>
      </div>
      <a
        href="https://github.com/parthjpatel99"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 block overflow-x-auto rounded-[20px] border border-border bg-surface p-5 transition-colors hover:border-accent sm:p-8"
      >
        <img
          src="https://ghchart.rshah.org/C2410C/parthjpatel99"
          alt="GitHub contribution chart for parthjpatel99"
          class="min-w-[640px] w-full dark:brightness-125"
          loading="lazy"
        />
      </a>
    </section>
  </main>
</Layout>
