---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../config";

const title = `About ${SITE.author}`;
const description = "Backend Software Engineer with 3+ years architecting real-time data systems and APIs for mission-critical autonomous industrial platforms.";
---

<Layout title={title} description={description}>
  <section class="max-w-3xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-8">About</h1>
    
    <div class="flex flex-col md:flex-row gap-8 items-start">
      <!-- Image Section -->
      <div class="w-full md:w-1/3 flex-shrink-0">
        <img 
          src="/about-portrait.jpg" 
          alt={SITE.author} 
          class="w-full max-h-72 object-cover rounded-2xl shadow-lg hover:shadow-xl transition-shadow duration-300 transform hover:scale-[1.02]"
        />
      </div>

      <!-- Content Section -->
      <div class="flex-1 prose dark:prose-invert max-w-none">
        <p class="lead text-lg mb-4">
          I build the backend systems behind Komatsu's autonomous mining fleet — real-time data services, AI-augmented developer tooling (including a custom <strong>MCP server</strong>), and production-scale deployments. Previously shipped features to <strong>200M+ users</strong> at Evernote and built deep learning pipelines at ISRO.
        </p>

        <p class="mb-6">
          Always open to conversations about backend systems, AI tooling, or hard infrastructure problems — <a href="mailto:parth8199@gmail.com" class="text-accent">feel free to reach out</a>.
        </p>

        <a href="#experience" class="no-underline border-b-2 border-dashed border-accent hover:border-solid transition-all">
          Check out my experience below.
        </a>
      </div>
    </div>

    <!-- GitHub Activity Section -->
    <div class="mt-16">
      <h2 class="text-2xl font-bold mb-6 font-mono">GitHub Activity</h2>
      <div class="p-4 border border-skin-line rounded-lg bg-skin-card opacity-80 hover:opacity-100 transition-opacity">
        <img 
          src={`https://ghchart.rshah.org/${SITE.author.split(' ')[0]}jpatel99`} 
          alt="GitHub Contribution Chart" 
          class="w-full dark:invert"
        />
      </div>
      <p class="mt-4 italic text-muted-foreground">
        I build what excites me and release it all as open source.
      </p>
    </div>
    
    <hr class="my-12 border-skin-line" />

    <!-- Experience Section -->
    <h2 id="experience" class="text-2xl font-bold mb-6 font-mono">Experience</h2>

    <div class="space-y-12">
      <div>
        <div class="flex flex-col sm:flex-row justify-between items-baseline mb-2">
          <h3 class="text-xl font-bold text-accent">Komatsu</h3>
          <span class="text-sm text-muted-foreground font-mono">Feb 2023 – Present</span>
        </div>
        <p class="mb-4 italic opacity-80">Software Engineer | Tucson, AZ</p>
        <ul class="list-disc pl-5 space-y-2 opacity-90">
          <li>Architected a <strong>Kotlin/Spring Boot</strong> data aggregation service for a mission-critical autonomous haulage system, processing real-time telemetry from an active mining fleet valued at <strong>$100K+/hour</strong>.</li>
          <li>Built an AI-augmented developer toolkit with a custom <strong>MCP server</strong>, cutting API verification time by <strong>50%</strong> and accelerating feature delivery by <strong>2x</strong>.</li>
          <li>Slashed developer onboarding time by <strong>75%</strong> and established an <strong>Azure CI/CD pipeline</strong> that unblocked cross-team delivery.</li>
          <li>Designed a Docker-based release pipeline achieving <strong>10x</strong> deployment velocity improvement.</li>
        </ul>
      </div>

       <div>
        <div class="flex flex-col sm:flex-row justify-between items-baseline mb-2">
          <h3 class="text-xl font-bold text-accent">Evernote</h3>
          <span class="text-sm text-muted-foreground font-mono">Jun 2022 – Aug 2022</span>
        </div>
        <p class="mb-4 italic opacity-80">Software Engineer Intern | Remote</p>
        <ul class="list-disc pl-5 space-y-2 opacity-90">
          <li>Shipped the "Repeat After Completion" recurring-task feature to <strong>50K+</strong> beta users using <strong>TypeScript/GraphQL</strong>.</li>
          <li>Deployed a reusable task-filtering component to <strong>200M+</strong> users across Web, Mobile, and Desktop.</li>
        </ul>
      </div>

      <div>
        <div class="flex flex-col sm:flex-row justify-between items-baseline mb-2">
          <h3 class="text-xl font-bold text-accent">ISRO – Space Applications Center</h3>
          <span class="text-sm text-muted-foreground font-mono">Dec 2020 – Apr 2021</span>
        </div>
        <p class="mb-4 italic opacity-80">Research Intern | Ahmedabad, India</p>
        <ul class="list-disc pl-5 space-y-2 opacity-90">
          <li>Achieved <strong>92%</strong> detection accuracy on oceanic eddy identification using a Python deep learning pipeline (Mask R-CNN, YOLO).</li>
          <li>Transformed raw satellite imagery datasets into structured ML training inputs for ocean circulation classification.</li>
        </ul>
      </div>
    </div>

    <div class="mt-16 p-8 bg-skin-card rounded-2xl border border-skin-line text-center">
      <h2 class="text-2xl font-bold mb-4">Stay Connected</h2>
      <p class="mb-6">Follow me on GitHub and catch the back-story in my contributions.</p>
      <div class="flex justify-center gap-4">
         <a href="https://github.com/parthjpatel99" target="_blank" rel="noopener noreferrer" class="px-6 py-3 bg-skin-fill text-skin-base font-bold rounded-lg border border-skin-line hover:bg-skin-card-muted transition-colors">
           GitHub
         </a>
         <a href="https://linkedin.com/in/parthjpatel99" target="_blank" rel="noopener noreferrer" class="px-6 py-3 bg-[#0077b5] text-white font-bold rounded-lg hover:opacity-90 transition-opacity">
           LinkedIn
         </a>
      </div>
    </div>

  </section>
</Layout>
