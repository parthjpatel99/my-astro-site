---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Endless Runner"
  description="Play my endless runner game — dodge obstacles and chase your high score."
>
  <section class="max-w-5xl mx-auto px-4 py-8">
    <div class="mb-6 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold">Endless Runner</h1>
        <p class="mt-2 text-sm opacity-70 font-mono">
          Dodge obstacles. Chase your high score.
        </p>
      </div>
      <a
        href="https://game.parthjpatel.me"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm font-mono text-accent hover:underline underline-offset-4 decoration-wavy shrink-0"
      >
        Open in new tab
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="inline-block"
        >
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
          <polyline points="15 3 21 3 21 9" />
          <line x1="10" y1="14" x2="21" y2="3" />
        </svg>
      </a>
    </div>

    <div class="game-frame-wrapper relative rounded-xl border border-border overflow-hidden shadow-lg">
      <div id="game-skeleton" class="game-skeleton">
        <div class="text-center">
          <div class="game-skeleton-pulse mx-auto mb-4"></div>
          <p class="text-sm font-mono opacity-60">Loading game...</p>
        </div>
      </div>

      <iframe
        id="game-iframe"
        src="https://game.parthjpatel.me"
        title="Endless Runner Game"
        class="game-iframe w-full border-0"
        loading="lazy"
        allow="autoplay; fullscreen"
        sandbox="allow-scripts allow-same-origin allow-popups"
      ></iframe>

      <!-- Fallback for no-iframe / JS-disabled contexts -->
      <noscript>
        <div class="p-8 text-center">
          <p class="mb-4 opacity-80">The game requires JavaScript to load.</p>
          <a
            href="https://game.parthjpatel.me"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block px-6 py-3 bg-accent text-background font-bold rounded-lg hover:opacity-90 transition-opacity"
          >
            Play on game.parthjpatel.me
          </a>
        </div>
      </noscript>
    </div>

    <p class="mt-4 text-xs opacity-50 font-mono text-center">
      Tip: Click the game area to focus, then use keyboard / touch controls to play.
    </p>
  </section>
</Layout>

<script>
  const iframe = document.getElementById('game-iframe');
  const skeleton = document.getElementById('game-skeleton');
  if (iframe && skeleton) {
    iframe.addEventListener('load', () => {
      skeleton.classList.add('loaded');
    });
  }
</script>

<style>
  .game-frame-wrapper {
    background: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 8px,
      var(--muted) 8px,
      var(--muted) 9px
    );
  }

  .game-iframe {
    aspect-ratio: 16 / 9;
    display: block;
    background-color: var(--background);
  }

  @media (max-width: 640px) {
    .game-iframe {
      aspect-ratio: 4 / 3;
      min-height: 360px;
    }
  }
</style>
