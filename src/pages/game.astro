---
import PageHeader from "@/components/PageHeader.astro";
import { GAME_URL } from "@/data/profile";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Endless Runner"
  description="Play my endless runner game — dodge obstacles and chase your high score."
>
  <main id="main-content" class="wrap">
    <PageHeader
      eyebrow="Recess · An endless runner"
      title="Take a break. Outrun the desert."
      description="Dodge the cacti, chase the high score. Press Space or ↑ to jump — or tap on a phone."
    >
      <a
        href={GAME_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="w-fit font-mono text-sm text-accent underline-offset-[5px] hover:underline"
      >
        Open {GAME_URL.replace("https://", "")} in a new tab ↗
      </a>
    </PageHeader>

    <div class="game-frame-wrapper relative overflow-hidden rounded-[20px] border border-border shadow-[0_24px_60px_-30px_rgba(40,25,10,0.5)]">
      <div id="game-skeleton" class="game-skeleton">
        <div class="text-center">
          <div class="game-skeleton-pulse mx-auto mb-4"></div>
          <p class="font-mono text-sm text-subtle">Warming up the engine…</p>
        </div>
      </div>

      <iframe
        id="game-iframe"
        src={GAME_URL}
        title="Endless Runner Game"
        class="game-iframe w-full border-0"
        loading="lazy"
        allow="autoplay; fullscreen"
        sandbox="allow-scripts allow-same-origin allow-popups"
      ></iframe>

      <!-- Fallback for no-iframe / JS-disabled contexts -->
      <noscript>
        <div class="p-8 text-center">
          <p class="mb-4 opacity-80">The game requires JavaScript to load.</p>
          <a
            href={GAME_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block rounded-full bg-accent px-6 py-3 font-semibold text-on-accent"
          >
            Play on game.parthjpatel.me
          </a>
        </div>
      </noscript>
    </div>

    <p class="mt-4 text-center font-mono text-xs tracking-[0.06em] text-subtle uppercase">
      Tip: click the game to focus it, then use the keyboard or touch to play.
    </p>
  </main>
</Layout>

<script>
  const iframe = document.getElementById('game-iframe');
  const skeleton = document.getElementById('game-skeleton');
  if (iframe && skeleton) {
    iframe.addEventListener('load', () => {
      skeleton.classList.add('loaded');
    });
  }
</script>

<style>
  .game-frame-wrapper {
    background: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 8px,
      var(--border) 8px,
      var(--border) 9px
    );
  }

  .game-iframe {
    aspect-ratio: 16 / 9;
    display: block;
    background-color: var(--background);
  }

  @media (max-width: 640px) {
    .game-iframe {
      aspect-ratio: 4 / 3;
      min-height: 360px;
    }
  }
</style>
