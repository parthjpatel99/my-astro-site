---
import Topo from "@/components/Topo.astro";
import { SITE } from "../config";
import Layout from "../layouts/Layout.astro";

const peaks = [
  { cx: 1140, cy: 320, count: 26, r0: 14, dr: 24, seed: 1.3, sx: 1.35, sy: 0.95 },
  { cx: 120, cy: 900, count: 12, r0: 30, dr: 30, seed: 3.4, sx: 1.3, sy: 0.8 },
];
---

<Layout title={`Off-route (404) | ${SITE.title}`} description="This page isn't on the map.">
  <main id="main-content" data-theme="dark" class="relative isolate flex min-h-[calc(100svh-4rem)] grow flex-col overflow-hidden bg-background text-foreground sm:min-h-[calc(100svh-72px)]">
    <div class="pointer-events-none absolute inset-y-0 right-0 -z-10 aspect-[1440/900] h-full max-md:-right-[40%]" aria-hidden="true">
      <Topo peaks={peaks} width={1440} height={900} preserveAspectRatio="none" class="absolute inset-0 size-full">
        <path d="M -20 780 C 240 720, 420 820, 640 700 S 980 520, 1460 560" fill="none" stroke="var(--accent)" stroke-width="2" stroke-dasharray="2 10" stroke-linecap="round"></path>
        <path d="M 1004 604 C 1040 520, 1080 420, 1120 300" fill="none" stroke="var(--subtle)" stroke-width="1.5" stroke-dasharray="6 6"></path>
        <circle cx="1120" cy="300" r="40" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-dasharray="4 6"></circle>
        <circle class="blink" cx="1120" cy="300" r="8" fill="var(--accent)"></circle>
        <g font-family="IBM Plex Mono, monospace" font-size="12" fill="var(--subtle)" letter-spacing="1">
          <text x="1172" y="294">LAST PING</text>
          <text x="1172" y="312">32.2291° N, 111.0103° W</text>
          <text x="1012" y="640">ROUTE ENDS HERE</text>
        </g>
      </Topo>
    </div>

    <div class="wrap flex grow flex-col justify-center gap-7 py-20">
      <span class="eyebrow text-accent">Signal lost · Error 404</span>
      <h1 class="font-display text-[clamp(6rem,15vw,12.5rem)] leading-[0.86] tracking-[-0.025em]">Off-<br />route.</h1>
      <p class="max-w-xl text-lg leading-relaxed text-foreground/80 sm:text-xl">
        This page isn’t on the map. Even autonomous haul trucks take a wrong turn sometimes — here’s the way back.
      </p>
      <div class="mt-2 flex flex-wrap items-center gap-3">
        <a href="/" class="flex h-[52px] items-center rounded-full bg-accent px-[26px] font-semibold text-on-accent transition-transform hover:-translate-y-0.5">Back to base</a>
        <a href="/posts" class="flex h-[52px] items-center rounded-full border border-foreground px-[26px] font-medium transition-colors hover:bg-foreground hover:text-background">Read a field note</a>
        <button type="button" data-palette-open class="flex h-[52px] items-center gap-2.5 rounded-full px-5 text-foreground/80 hover:text-foreground">
          or press <kbd data-mod-key>⌘K</kbd>
        </button>
      </div>
    </div>
  </main>
</Layout>
