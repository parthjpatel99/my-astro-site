---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../config";
---

<Layout title={`404 Not Found | ${SITE.title}`}>
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4">
    <h1 class="text-9xl font-bold text-muted mb-4">404</h1>
    <h2 class="text-2xl font-bold mb-8">Page Not Found</h2>
    <p class="mb-8 text-xl">The page you're looking for doesn't exist or has been moved.</p>
    <a
      href="/"
      class="px-6 py-3 bg-accent text-white font-medium rounded-lg hover:opacity-90 transition-opacity"
    >
      Go Home
    </a>
  </div>
</Layout>
