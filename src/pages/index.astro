---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../config';
---

<Layout>
  <div class="max-w-3xl mx-auto px-4 py-20">
    <div class="mb-12">
      <h1 class="text-4xl font-bold mb-4 font-mono">Hi, I'm {SITE.author}.</h1>
      <p class="text-xl text-muted-foreground mb-8 leading-relaxed">
        Software Engineer based in <strong>Tucson, AZ</strong>.
        I build scalable backend systems, cloud infrastructure, and low-latency microservices.
      </p>
      
      <div class="flex gap-4">
        <a href="/about" class="px-6 py-3 bg-accent text-white font-medium rounded-lg hover:opacity-90 transition-opacity">
          More About Me
        </a>
        <a href="/posts" class="px-6 py-3 border border-border bg-background text-foreground font-medium rounded-lg hover:bg-muted/30 transition-colors">
          Read Blog
        </a>
      </div>
    </div>

    <div class="border-t border-border pt-12">
      <h2 class="text-2xl font-bold mb-6">Latest Tech Stack</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-sm font-mono">
        <div class="bg-muted/30 p-3 rounded border border-border text-center">Kotlin / Java</div>
        <div class="bg-muted/30 p-3 rounded border border-border text-center">Spring Boot</div>
        <div class="bg-muted/30 p-3 rounded border border-border text-center">Kubernetes</div>
        <div class="bg-muted/30 p-3 rounded border border-border text-center">Azure / GCP</div>
      </div>
    </div>
  </div>
</Layout>
